# =======================================================================
# Ansible Inventory — ProxmoxInfra Windows Lab
# =======================================================================
# Copy this file to lab.yml and fill in your actual values:
#
#   cp inventory/lab.yml.example inventory/lab.yml
#   nano inventory/lab.yml
#
# lab.yml is excluded from git (.gitignore) to prevent committing credentials.
#
# PASSWORDS:
#   ansible_password references {{ admin_password }} which is resolved from
#   inventory/group_vars/all/main.yml -> vault.yml (ansible-vault encrypted).
#   To create the vault:
#     cp inventory/group_vars/all/vault.yml.example \
#        inventory/group_vars/all/vault.yml
#     ansible-vault encrypt inventory/group_vars/all/vault.yml
#
# OPTIONAL HOSTS:
#   Hosts marked "optional" are disabled by default.  Enable them by
#   setting the corresponding toggle in terraform.tfvars and then
#   uncommenting the host entry here.
#
# USAGE:
#   ansible-playbook -i inventory/lab.yml playbooks/site.yml
#   ansible-playbook -i inventory/lab.yml playbooks/dc.yml
#   ansible-playbook -i inventory/lab.yml playbooks/dc.yml --tags validate
# =======================================================================

all:
  children:

    # =======================================================================
    # WINDOWS HOSTS
    # All inherit WinRM defaults from group_vars/windows.yml
    # =======================================================================
    windows:
      children:

        # -------------------------------------------------------------------
        # Primary Domain Controller (required)
        # Terraform toggle: always enabled (VM 101)
        # -------------------------------------------------------------------
        dc:
          hosts:
            lab-dc01:
              ansible_host: 10.10.10.10
              # Use the local Administrator account before and after domain
              # promotion.  Switch to kerberos transport after domain join
              # if Kerberos is available in your environment.
              ansible_user: Administrator
              ansible_password: "{{ admin_password }}"

        # -------------------------------------------------------------------
        # Secondary Domain Controller (optional)
        # Terraform toggle: enable_dc02 = true (VM 105)
        # Uncomment to use.
        # -------------------------------------------------------------------
        dc02:
          hosts:
            # lab-dc02:
            #   ansible_host: 10.10.10.11
            #   ansible_user: Administrator
            #   ansible_password: "{{ admin_password }}"

        # -------------------------------------------------------------------
        # SCCM + SQL Server (required)
        # Terraform toggle: always enabled (VM 102)
        # -------------------------------------------------------------------
        sccm:
          hosts:
            lab-sccm01:
              ansible_host: 10.10.10.20
              ansible_user: Administrator
              ansible_password: "{{ admin_password }}"

        # -------------------------------------------------------------------
        # Enterprise Root CA (optional)
        # Terraform toggle: enable_ca = true (VM 104)
        # Uncomment to use.
        # -------------------------------------------------------------------
        ca:
          hosts:
            # lab-ca01:
            #   ansible_host: 10.10.10.30
            #   ansible_user: Administrator
            #   ansible_password: "{{ admin_password }}"

        # -------------------------------------------------------------------
        # Azure AD Connect / Hybrid Azure AD Join (optional)
        # Terraform toggle: enable_aadconnect = true (VM 106)
        # Uncomment to use.
        # -------------------------------------------------------------------
        aadconnect:
          hosts:
            # lab-aadc01:
            #   ansible_host: 10.10.10.40
            #   ansible_user: Administrator
            #   ansible_password: "{{ admin_password }}"

        # -------------------------------------------------------------------
        # Windows 11 Clients
        # lab-client01 is required; lab-client02 is optional (VM 103 / future)
        # Terraform toggle for second client: enable_client02 = true
        # -------------------------------------------------------------------
        clients_win:
          hosts:
            lab-client01:
              ansible_host: 10.10.10.50
              ansible_user: Administrator
              ansible_password: "{{ admin_password }}"

            # lab-client02:          # optional — enable_client02 = true
            #   ansible_host: 10.10.10.51
            #   ansible_user: Administrator
            #   ansible_password: "{{ admin_password }}"

    # =======================================================================
    # LINUX HOSTS
    # All inherit SSH defaults from group_vars/linux.yml
    # =======================================================================
    linux:
      children:

        # -------------------------------------------------------------------
        # Linux Clients (optional)
        # Terraform toggles:
        #   enable_linux_client = true   → lab-linux01 (Ubuntu 22.04)
        #   linux_client_count  = 2      → also lab-linux02 (Rocky Linux 9)
        # Uncomment to use.
        # -------------------------------------------------------------------
        clients_linux:
          hosts:
            # lab-linux01:           # optional — enable_linux_client = true
            #   ansible_host: 10.10.10.60
            #   ansible_user: ubuntu  # default user for Ubuntu cloud images

            # lab-linux02:           # optional — linux_client_count = 2
            #   ansible_host: 10.10.10.61
            #   ansible_user: rocky  # default user for Rocky Linux cloud images

        # -------------------------------------------------------------------
        # OPNsense Firewall (optional)
        # Terraform toggle: enable_opnsense = true (VM 100, LAN IP 10.10.10.1)
        # OPNsense supports SSH management on port 22.
        # Uncomment to use.
        # -------------------------------------------------------------------
        opnsense:
          hosts:
            # lab-opnsense01:        # optional — enable_opnsense = true
            #   ansible_host: 10.10.10.1
            #   ansible_user: root
            #   ansible_connection: ssh
            #   ansible_port: 22

        # -------------------------------------------------------------------
        # NAS / Open-Source Services  (optional)
        # -------------------------------------------------------------------

        # VM 120 – TrueNAS Scale NAS (configured via web UI, not Ansible)
        # Uncomment only if you want Ansible to manage TrueNAS over SSH.
        # TrueNAS is normally administered through its web UI on port 80.
        nas:
          hosts:
            # lab-nas01:             # optional — enable_nas = true
            #   ansible_host: 10.10.10.70
            #   ansible_user: root   # TrueNAS root account
            #   ansible_connection: ssh
            #   ansible_port: 22

        # VM 121 – Nginx Proxy Manager (Ubuntu + Docker)
        nginx:
          hosts:
            # lab-nginx01:           # optional — enable_nginx = true
            #   ansible_host: 10.10.10.71
            #   ansible_user: ubuntu
            #   ansible_connection: ssh

        # VM 122 – Paperless-ngx (Ubuntu + Docker Compose)
        paperless:
          hosts:
            # lab-paperless01:       # optional — enable_paperless = true
            #   ansible_host: 10.10.10.72
            #   ansible_user: ubuntu
            #   ansible_connection: ssh

        # VM 123 – GitLab CE (Ubuntu + Docker Compose)
        gitlab:
          hosts:
            # lab-gitlab01:          # optional — enable_gitlab = true
            #   ansible_host: 10.10.10.73
            #   ansible_user: ubuntu
            #   ansible_connection: ssh
