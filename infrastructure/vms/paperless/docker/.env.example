# =======================================================================
# Paperless-ngx — Environment Configuration
# =======================================================================
# Copy this file to .env and fill in the values.
# The .env file is read by Docker Compose and must not be committed.
# =======================================================================

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------

# Secret key — generate a long random string:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PAPERLESS_SECRET_KEY=change-me-to-a-long-random-string

# Time zone for date parsing and OCR (must match your locale)
PAPERLESS_TIME_ZONE=Europe/Berlin

# OCR languages — space-separated Tesseract language codes
# Common: deu (German), eng (English), fra (French)
PAPERLESS_OCR_LANGUAGE=deu+eng

# -----------------------------------------------------------------------
# URL / Networking
# -----------------------------------------------------------------------

# The URL Paperless is accessed at (used for email links and CSRF check)
PAPERLESS_URL=http://10.10.10.72:8000

# Allowed hostnames (comma-separated, no spaces)
PAPERLESS_ALLOWED_HOSTS=10.10.10.72,paperless.lab.local

# -----------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------

PAPERLESS_DBHOST=db
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=paperless-db-pass

# -----------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------

PAPERLESS_REDIS=redis://broker:6379

# -----------------------------------------------------------------------
# Admin account (created automatically on first startup if set)
# -----------------------------------------------------------------------

PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme
PAPERLESS_ADMIN_MAIL=admin@lab.local

# -----------------------------------------------------------------------
# NAS consume directory (optional)
# -----------------------------------------------------------------------
# Mount the NAS consume share as a local volume and point Paperless to it.
# TrueNAS: mount the SMB share on this VM and set the path below.
# Example: mount -t cifs //10.10.10.70/consume /mnt/nas-consume -o ...
# Then change the consume volume in docker-compose.yml:
#   ./consume:/usr/src/paperless/consume   →   /mnt/nas-consume:/usr/src/paperless/consume
