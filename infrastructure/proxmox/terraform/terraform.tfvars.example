# =======================================================================
# terraform.tfvars.example
# =======================================================================
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is excluded from git (.gitignore) to prevent
# committing sensitive credentials.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   nano terraform.tfvars
# =======================================================================

# -----------------------------------------------------------------------
# Proxmox connection
# -----------------------------------------------------------------------

# Full HTTPS URL of your Proxmox host API.
# Include the trailing slash.
proxmox_endpoint = "https://192.168.1.100:8006/"

# Proxmox API token in format: user@realm!tokenid=secret
# See docs/prerequisites.md for how to create this token.
# Set this in terraform.tfvars or via environment variable:
#   export TF_VAR_proxmox_api_token="terraform@pam!lab=..."
proxmox_api_token = "terraform@pam!lab=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Name of your Proxmox node (shown in the UI sidebar, usually "pve").
proxmox_node = "pve"

# -----------------------------------------------------------------------
# Network bridges
# -----------------------------------------------------------------------

# Internal lab bridge (no uplink, isolated).
# Created manually on Proxmox: vmbr1 at 10.10.10.1/24.
lab_network_bridge = "vmbr1"

# Home LAN bridge. Change if your WAN bridge is named differently.
wan_bridge = "vmbr0"

# -----------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------

# Storage ID for ISO images (where you uploaded the ISOs).
# Check Proxmox UI: Datacenter → pve → local → ISO Images.
iso_storage = "local"

# Storage ID for VM disks. Use "local-lvm" for LVM thin provisioning
# or "local" for directory-based storage.
vm_storage = "local-lvm"

# -----------------------------------------------------------------------
# ISO filenames
# -----------------------------------------------------------------------
# These must exactly match the filenames shown in Proxmox local → ISO Images.

# Windows Server 2022 Evaluation ISO filename.
# Download from: https://www.microsoft.com/en-us/evalcenter/evaluate-windows-server-2022
windows_server_iso = "WinSrv2022_EN-US_eval.iso"

# Windows 11 Enterprise Evaluation ISO filename.
# Download from: https://www.microsoft.com/en-us/evalcenter/evaluate-windows-11-enterprise
windows_11_iso = "Win11_Ent_eval_x64.iso"

# VirtIO drivers ISO filename (for paravirtualized storage + network drivers).
# Download from: https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/
virtio_iso = "virtio-win.iso"

# -----------------------------------------------------------------------
# Active Directory domain
# -----------------------------------------------------------------------

# AD domain FQDN. Used in setup-dc.ps1 and Ansible playbooks.
domain_name = "lab.local"

# NetBIOS domain name (pre-Windows 2000 style). Keep it short, uppercase.
domain_netbios = "LAB"

# -----------------------------------------------------------------------
# Credentials
# -----------------------------------------------------------------------
# Change these from the defaults before using in a real lab.
# Passwords must meet Windows complexity requirements:
#   - At least 8 characters (12+ recommended)
#   - Uppercase + lowercase + number + symbol

# Directory Services Restore Mode (DSRM) password for the DC.
# Needed for AD recovery scenarios.
safe_mode_password = "S@feModeP@ss1!"

# Local Administrator password set on each VM.
# You will use this to log in for the first time after OS installation.
admin_password = "LabAdm1n!2024"

# -----------------------------------------------------------------------
# Optional extension VMs  (see docs/extensions.md)
# -----------------------------------------------------------------------
# All default to false. Set to true to create the corresponding VM.
# Run `terraform apply` after changing — it will create only the new VM.

# VM 100 – lab-fw01: pfSense router/firewall (NAT + segmentation).
# Download pfSense CE ISO and upload to Proxmox before enabling.
# When enabling, also remove 10.10.10.1 from the Proxmox host's vmbr1.
enable_pfsense = false
pfsense_iso    = "pfSense-CE-2.7.2-RELEASE-amd64.iso"

# VM 104 – lab-ca01: Enterprise Root CA (AD CS).
enable_ca = false

# VM 105 – lab-dc02: Secondary Domain Controller.
enable_dc02 = false

# VM 106 – lab-aadc01: Azure AD Connect / Entra Connect Sync.
# Requires internet access (enable_pfsense or temporary uplink).
enable_aadconnect = false

# -----------------------------------------------------------------------
# Optional WSUS content disk on lab-sccm01 (Software Update Point)
# -----------------------------------------------------------------------
# Set to 0 to skip. 150 GB is a practical minimum for a Windows 11 + Server
# update baseline. The disk appears as scsi2 and is initialized as E:\WSUS
# by setup-wsus-sup.ps1.
wsus_content_disk_size = 0

# -----------------------------------------------------------------------
# OPNsense (alternative to pfSense — mutually exclusive)
# -----------------------------------------------------------------------
# Download OPNsense ISO from https://opnsense.org/download/ (DVD image, amd64)
# NOTE: Do NOT enable both enable_pfsense and enable_opnsense simultaneously.
enable_opnsense = false
opnsense_iso    = "OPNsense-24.7-dvd-amd64.iso"

# -----------------------------------------------------------------------
# Additional Windows 11 client (lab-client02, VM 108)
# -----------------------------------------------------------------------
enable_client02 = false

# -----------------------------------------------------------------------
# Linux clients (Ubuntu 22.04 and/or Rocky Linux 9)
# -----------------------------------------------------------------------
# Download Ubuntu 22.04 LTS: https://ubuntu.com/download/server
# Download Rocky Linux 9:    https://rockylinux.org/download
# linux_client_count: 1 = Ubuntu only, 2 = Ubuntu + Rocky Linux
enable_linux_client = false
linux_client_count  = 1
ubuntu_iso          = "ubuntu-22.04.4-live-server-amd64.iso"
rocky_iso           = "Rocky-9.4-x86_64-dvd.iso"

# -----------------------------------------------------------------------
# Microsoft Entra Cloud Sync (VM 109) — lightweight hybrid identity agent
# -----------------------------------------------------------------------
# Alternative to Entra Connect Sync (enable_aadconnect, VM 106). Cloud Sync
# uses a lightweight provisioning agent configured from the Entra portal.
# Requires internet access. You may run both VM 106 and VM 109 to compare.
enable_cloudsync = false

# -----------------------------------------------------------------------
# Two-tier PKI (VMs 112 + 113) — offline Root CA + Enterprise Issuing CA
# -----------------------------------------------------------------------
# The realistic enterprise PKI design. VM 112 is an offline standalone Root
# CA (workgroup); VM 113 is the domain-joined Enterprise Issuing CA.
# Do NOT enable both enable_ca (single-tier, VM 104) and enable_twotier_pki.
enable_twotier_pki = false
