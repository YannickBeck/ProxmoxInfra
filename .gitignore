# =======================================================================
# ProxmoxInfra .gitignore
# =======================================================================

# -----------------------------------------------------------------------
# Terraform
# -----------------------------------------------------------------------
# Provider plugins and modules (downloaded by terraform init)
**/.terraform/
# Dependency lock files are intentionally committed for reproducible providers.

# State files — contain sensitive resource details, never commit
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.*.backup
errored.tfstate
.terraform.tfstate.lock.info
terraform.tfstate.d/

# Saved plans and machine-readable plan output may contain secrets
*.tfplan
*.tfplan.*
*.plan
tfplan
tfplan.*
plan.out
plan.json
*-plan.json

# Backend and Terraform CLI credential configuration
*.tfbackend
backend.hcl
backend*.hcl
*.backend.hcl
credentials.tfrc.json
.terraformrc
terraform.rc
!*.tfbackend.example
!backend.hcl.example
!backend*.hcl.example
!*.backend.hcl.example

# Crash logs
crash.log
crash.*.log

# Actual tfvars files (contain secrets — only commit .example versions)
terraform.tfvars
!terraform.tfvars.example
*.auto.tfvars
!*.auto.tfvars.example
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Override files (local-only Terraform customisations)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# -----------------------------------------------------------------------
# Ansible
# -----------------------------------------------------------------------
# Actual inventory files (contain credentials — only commit .example)
ansible/inventory/lab.yml
!ansible/inventory/lab.yml.example

# Ansible retry files
*.retry

# Ansible vault password files
.vault_pass
vault_password_file
ansible/inventory/**/vault.yml
ansible/inventory/**/vault.yaml

# -----------------------------------------------------------------------
# Environment / secrets
# -----------------------------------------------------------------------
.env
.env.*
*.env
!*.env.example

# Node / Docusaurus generated content
**/node_modules/
**/.docusaurus/

# OpenStack authentication material
**/clouds.yaml
**/clouds.yml
**/secure.yaml
**/secure.yml
**/openrc
**/openrc.sh
**/*-openrc.sh

# SSH keys
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# -----------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# -----------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------
*.log
logs/

# -----------------------------------------------------------------------
# OS and editor files
# -----------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Linux
*~

# VS Code
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json

# JetBrains IDEs
.idea/
*.iml

# -----------------------------------------------------------------------
# Temporary files
# -----------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
